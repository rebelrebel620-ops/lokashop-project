# Merge these settings into your EXISTING .env for HTTPS hosting.
# Preserve your current APP_KEY, database credentials, and mail credentials.
# Replace APP_URL below if your actual domain differs.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://logistics.lokashop.trade
SESSION_SECURE_COOKIE=true
# Set the SAME existing absolute shared-upload directories in both websites.
# LOKASHOP_PRIVATE_STORAGE=C:/path/to/lokashop-shared/private
# LOKASHOP_PUBLIC_STORAGE=C:/path/to/lokashop-shared/public
