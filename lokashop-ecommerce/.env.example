APP_NAME=LokaShop
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lokashop_db
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=LokaShop
# Keep both projects side by side; uploads use ../lokashop-shared by default.
# For separate hosts, set these to the same mounted shared-storage directories.
# LOKASHOP_PRIVATE_STORAGE=C:/path/to/lokashop-shared/private
# LOKASHOP_PUBLIC_STORAGE=C:/path/to/lokashop-shared/public
